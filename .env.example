BOT_VERSION=v1.4.1
# Discord
DISCORD_TOKEN=DEIN_DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=
BOT_COMMAND_PREFIX=!
MESSAGE_CONTENT_INTENT=true
LOG_LEVEL=INFO

# OpenAI / AI
AI_CHAT_ENABLED=true
OPENAI_API_KEY=DEIN_OPENAI_API_KEY
OPENAI_MODEL=DEIN_MODELL
AI_CHAT_API_MODE=responses
AI_CHAT_MAX_OUTPUT_TOKENS=1000
AI_CHAT_TIMEOUT_SECONDS=45
AI_CHAT_USER_COOLDOWN_SECONDS=3

# Channel-Schutz
AI_CHAT_ALLOWED_CHANNEL_IDS=DEIN_PRIVATER_CHANNEL_ID
AI_CHAT_MUM_CHANNEL_ID=
LYVRA_FAMILY_CHANNEL_IDS=
AI_CHAT_REPLY_ON_MENTION=true
AI_CHAT_AUTO_REPLY=false

# Bot-Family / Geschwisterbots
LYVRA_RESPOND_TO_FAMILY_BOTS=false
LYVRA_FAMILY_BOT_IDS=
LYVRA_FAMILY_BOT_NAMES=
LYVRA_BOT_LOOP_GUARD_SECONDS=12

# LYVRA Core / Memory
LYVRA_MEMORY_ENABLED=true
LYVRA_MEMORY_DB_PATH=
LYVRA_WORKING_MEMORY_DAYS=2
LYVRA_SHORT_CONTEXT_MESSAGES=24
LYVRA_LONG_MEMORY_LIMIT=8
LYVRA_AUTO_MARKANT_LEARNING=true
LYVRA_EXPLICIT_LEARN_ONLY=false
LYVRA_TRAIT_LEARNING_ENABLED=true
LYVRA_RELATIONSHIP_LEARNING_ENABLED=true

# Optional Zusatzregeln
AI_CHAT_CHARACTER_NAME=LYVRA
AI_CHAT_CHARACTER_FILE=
AI_CHAT_CHARACTER_PROMPT=
AI_CHAT_SYSTEM_PROMPT_EXTRA=

# Living Baseline / automatische Reaktionskalibrierung
LYVRA_FEEDBACK_LEARNING_ENABLED=true
LYVRA_FEEDBACK_CONTEXT_MINUTES=30
LYVRA_AUTO_BASELINE_PROMOTION=true
LYVRA_CREATOR_USER_IDS=
LYVRA_MUM_USER_IDS=
LYVRA_CREATOR_LANGUAGE=de
LYVRA_MUM_LANGUAGE=en
LYVRA_DEFAULT_LANGUAGE=auto
LYVRA_LANGUAGE_REPAIR_ENABLED=true

# Character Continuity Memory & Recall Engine
LYVRA_CHARACTER_CONTINUITY_ENABLED=true
LYVRA_CHARACTER_STATE_DIR=./character_state
LYVRA_CHARACTER_RECENT_DAYS=2
LYVRA_CHARACTER_RECALL_LIMIT=10
LYVRA_CHARACTER_CONTEXT_CHARS=12000
LYVRA_CHARACTER_AUTO_EVENT_RECORDING=true
